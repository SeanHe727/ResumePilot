{
  "name": "resumepilot",
  "version": "0.1.0",
  "description": "Resume diagnosis Agent built on a hand-written 10-layer Harness — no LangChain, no LangGraph.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "tsx src/index.ts start",
    "diagnose": "tsx src/index.ts diagnose",
    "build-kb": "tsx src/index.ts build-kb",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run tests/e2e"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "better-sqlite3": "^13.0.3",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "openai": "^7.10.0",
    "ora": "^9.4.1",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
