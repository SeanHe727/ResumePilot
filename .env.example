# ---- LLM providers -----------------------------------------------------------
# Anthropic: primary provider for diagnosis and rewriting.
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI: embeddings for the knowledge base, plus cross-validation.
OPENAI_API_KEY=sk-...

# DeepSeek: cheap provider for lightweight structural tasks (OpenAI-compatible API).
DEEPSEEK_API_KEY=sk-...

# ---- Model routing -----------------------------------------------------------
# Heavy reasoning: bullet diagnosis, rewriting, final report.
RESUMEPILOT_MODEL_PRIMARY=claude-opus-5
# Lighter Anthropic tier, used where the primary model is overkill.
RESUMEPILOT_MODEL_SECONDARY=claude-sonnet-5
# Structural/mechanical work: section splitting, bullet segmentation.
RESUMEPILOT_MODEL_CHEAP=deepseek-v4-flash
# Knowledge base vectorisation.
RESUMEPILOT_MODEL_EMBEDDING=text-embedding-3-small

# ---- Budget ------------------------------------------------------------------
# Hard ceiling in USD for a single diagnosis session; the Query Engine refuses
# to issue further requests once this is reached.
RESUMEPILOT_MAX_COST_USD=2.0

# ---- Storage -----------------------------------------------------------------
RESUMEPILOT_DATA_DIR=./data
